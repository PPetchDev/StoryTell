# /srv/storytell/live.env on the VM: the backup job's own settings (scripts/backup.mjs).
# DATABASE_URL is deliberately not here; the systemd unit hands it over from /etc/storytell/api.env.
LIVE_IMAGE_DIR=/srv/storytell/images
# A folder outside /srv/storytell, owned by the storytell user. It is on the VM's own disk, so it
# guards against a bad deploy or a mistake, not against losing the VM: set BACKUP_REMOTE too.
BACKUP_DISK_DIR=/var/backups/storytell
BACKUP_KEEP=14
# An rclone crypt remote, so only encrypted files leave the VM (docs/adr/0003). Unset until one is configured.
# BACKUP_REMOTE=storytell-backup:
