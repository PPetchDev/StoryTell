# Copy to .env (git-ignored) to override dev defaults or add provider keys.
# `npm run dev` reads this file; real environment variables win over it.

# --- Dev ports (defaults shown). Live uses its own ports and database; see README. ---
# DEV_WEB_PORT=3001
# DEV_API_PORT=4001
# DEV_PG_PORT=54321

# --- Model Gateway ---
# `real` talks to the providers. `fake` is the scripted test double.
# MODEL_GATEWAY=real
# OPENROUTER_API_KEY=
# VENICE_API_KEY=          # the Venice inference key; VENICE_INFERENCE_KEY works too
# VENICE_ADMIN_KEY=        # optional: lets the Usage view read the image credit balance

# --- What the API itself reads (dev sets these for you; live sets them from .env.live) ---
# PORT=4000
# DATABASE_URL=postgres://user:password@127.0.0.1:5432/storytell
# IMAGE_DIR=C:/StorytellLive/images
# ENV_FILE=.env.live   # optional: load these variables from a file at startup

# --- Live instance: copy this block into .env.live (git-ignored), uncommented ---
# `npm run live:deploy` reads .env.live and copies it to LIVE_HOME/live.env for the live app.
# LIVE_HOME=C:/StorytellLive            # releases, logs and (by default) images; outside this checkout
# LIVE_WEB_PORT=3000                    # Tailscale serve fronts this port
# LIVE_API_PORT=4000
# LIVE_IMAGE_DIR=C:/StorytellLive/images
# DATABASE_URL=postgres://storytell:<password>@127.0.0.1:5432/storytell_live
# OPENROUTER_API_KEY=
# VENICE_API_KEY=
# VENICE_ADMIN_KEY=
# --- Daily backup (README: "Daily backup"); leave a target unset to skip it ---
# BACKUP_DISK_DIR=D:/StorytellBackups   # a folder on the second disk
# BACKUP_REMOTE=storytell-backup:       # an rclone crypt remote over Google Drive
# BACKUP_KEEP=14                        # backups kept per target
# PG_BIN=C:/Program Files/PostgreSQL/18/bin   # where pg_dump.exe is, if not the EDB default
# RCLONE=rclone                         # the rclone executable, if not on PATH

# --- What the frontend reads ---
# API_ORIGIN=http://127.0.0.1:4000   # where Next.js proxies /api; needed at build and start
# INSTANCE_LABEL=dev                 # shown in the app name, so dev and live PWAs differ
