{
    "name": "@storytell/api",
    "version": "0.0.1",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "nest build",
        "start": "node dist/main.js",
        "start:dev": "nest start --watch",
        "migrate": "node dist/migrate.js",
        "migration:generate": "nest build && typeorm migration:generate -d dist/store/db/cli-data-source.js",
        "typecheck": "tsc --noEmit -p tsconfig.json",
        "test": "vitest run",
        "test:watch": "vitest",
        "smoke:live": "node scripts/smoke-live.mjs"
    },
    "dependencies": {
        "@nestjs/common": "^12.3.2",
        "@nestjs/core": "^12.3.2",
        "@nestjs/platform-express": "^12.3.2",
        "@nestjs/swagger": "^12.1.0",
        "@nestjs/typeorm": "^12.0.2",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.15.1",
        "pg": "^8.23.1",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.2",
        "typeorm": "^1.1.2"
    },
    "devDependencies": {
        "@nestjs/cli": "^12.0.11",
        "@nestjs/schematics": "^12.0.12",
        "@nestjs/testing": "^12.3.2",
        "@types/express": "^5.0.6",
        "@types/node": "^24.19.2",
        "@types/pg": "^8.23.1",
        "@types/supertest": "^7.2.1",
        "embedded-postgres": "^18.6.0-beta.19",
        "supertest": "^7.3.1",
        "typescript": "^6.0.3",
        "vite": "^8.3.5",
        "vitest": "^4.1.12"
    }
}
