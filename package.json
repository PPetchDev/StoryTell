{
    "name": "storytell-ai",
    "private": true,
    "type": "module",
    "workspaces": [
        "apps/api",
        "apps/web"
    ],
    "engines": {
        "node": ">=24.11"
    },
    "scripts": {
        "dev": "node scripts/dev.mjs",
        "build": "npm run build -w apps/api && npm run build -w apps/web",
        "test:api": "npm test -w apps/api",
        "test:e2e": "npm run test:e2e -w apps/web",
        "typecheck": "npm run typecheck -w apps/api && npm run typecheck -w apps/web",
        "live:deploy": "node scripts/live.mjs deploy",
        "live:start": "node scripts/live.mjs start",
        "live:stop": "node scripts/live.mjs stop",
        "live:status": "node scripts/live.mjs status",
        "live:rollback": "node scripts/live.mjs rollback"
    },
    "devDependencies": {
        "embedded-postgres": "^18.6.0-beta.19"
    },
    "allowScripts": {
        "@embedded-postgres/windows-x64@18.6.0-beta.19": true,
        "@scarf/scarf": false
    }
}
